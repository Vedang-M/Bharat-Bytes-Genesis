# Dependencies
node_modules/

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# ML Models Cache
ml/models/*.joblib
ml/models/

# Firebase (NEVER commit service account keys!)
firebase-service-account.json
*-service-account.json
*.json.key

# OS misc
.DS_Store
Thumbs.db

# ==================== LARGE DATA FILES ====================
# NetCDF files (climate/rainfall data)
*.nc
*.nc4
data/*.nc
data/raw/*.nc

# HDF5 files (hierarchical data)
*.h5
*.hdf5
data/*.h5

# Pickle files (serialized Python objects)
*.pkl
*.pickle
models/*.pkl

# NumPy arrays
*.npy
*.npz

# Parquet/Feather (large tabular data)
*.parquet
*.feather

# CSV data files (raw datasets)
data/raw/*.csv
data/training/*.csv

# Compressed data archives
data/*.gz
data/*.zip
data/*.tar

# Jupyter checkpoints
.ipynb_checkpoints/

# Model weights and checkpoints
*.pth
*.pt
checkpoints/
